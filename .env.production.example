# Test-mode deployment. Do not commit this filled file.
IMAGE_PREFIX=dad
# Name each build (for example the git commit) so a rollback can select the previous one.
IMAGE_TAG=
# Compose interpolates this file; services receive explicit allowlists. Database
# credentials remain in .env.database (see .env.database.example).
DONOR_PUBLIC_ORIGIN=https://donors.example.org
# Optional: the origin the donor apps' hosted checkout returns to (its /app/return page).
# Defaults to DONOR_PUBLIC_ORIGIN; set it only when that page is served from another origin.
# DONOR_NATIVE_RETURN_ORIGIN=
# The back office's own HTTPS host. It must differ from the public host; nginx serves each
# its own paths.
DONOR_STAFF_ORIGIN=https://staff.donors.example.org
# nginx overwrites this header with the client address on every request. Leave empty
# to make every visitor share one rate-limit quota.
DONOR_CLIENT_IP_HEADER=X-Real-IP
# cloudflare: only Cloudflare reaches the origin (Authenticated Origin Pulls) and names the
# client in CF-Connecting-IP. direct: clients connect to nginx themselves. See docs/edge.md.
INGRESS_MODE=cloudflare
# Host directory holding fullchain.pem and privkey.pem, readable by uid 101.
INGRESS_TLS_DIR=/etc/dad/tls
# Optional: your own Authenticated Origin Pulls CA instead of Cloudflare's shared one.
# INGRESS_ORIGIN_PULL_CA=/etc/dad/origin-pull-ca.pem
# Optional: nginx allow/deny rules for the staff host.
# INGRESS_STAFF_ACCESS=/etc/dad/staff-access.conf
# DONOR_TRUSTED_PROXY_CIDRS is fixed by docker-compose.prod.yml to the web container.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The account's Stripe request limit, shared by all Stripe callers: 25 in a sandbox.
DONOR_STRIPE_REQUESTS_PER_SECOND=25
DONOR_GO_WORKERS_ENABLED=false
# Independent 32-byte URL-safe base64 keys: openssl rand -base64 32 | tr '+/' '-_'
# During a rotation each holds a comma-separated list, new key first; keep retired keys in
# the secret store while backups need them. See docs/operations.md#encryption-keys.
DONOR_CONTENT_ENCRYPTION_KEY=
DONOR_EMAIL_ENCRYPTION_KEY=
DONOR_SMTP_HOST=
DONOR_SMTP_PORT=587
DONOR_SMTP_USERNAME=
DONOR_SMTP_PASSWORD=
DONOR_EMAIL_FROM=
API_PORT=8002
# Next.js processes behind nginx: one per core left after the API and nginx.
WEB_REPLICAS=1
# Optional Wallet issuance. Mount private files read-only into the API container.
# Apple accepts PEM or DER certificates and an unencrypted PEM RSA private key.
DONOR_WALLET_APPLE_CERT_FILE=
DONOR_WALLET_APPLE_KEY_FILE=
DONOR_WALLET_APPLE_WWDR_FILE=
# Google service-account JSON and an existing approved Generic class ID.
DONOR_WALLET_GOOGLE_KEY_FILE=
DONOR_WALLET_GOOGLE_CLASS_ID=
# Optional app notifications; mount delivery keys read-only into the push worker only.
# API device registration is derived from the configured key paths. Override with
# IOS,ANDROID (comma-separated) or none when registration and delivery are managed separately.
DONOR_PUSH_PLATFORMS=
# Leave blank to disable; see docs/operations.md.
# APNs: the .p8 authentication key, its key ID, the team ID, and the app's bundle ID.
DONOR_PUSH_APNS_KEY_FILE=
DONOR_PUSH_APNS_KEY_ID=
DONOR_PUSH_APNS_TEAM_ID=
DONOR_PUSH_APNS_TOPIC=
# FCM: the Firebase service-account JSON key.
DONOR_PUSH_FCM_KEY_FILE=
# Optional donor app associations, built into the web image: universal links, app links,
# and passkeys shared between the app and this site. Leave blank until the app is
# published; /.well-known then answers 404 rather than naming an app that does not exist.
# iOS: <team ID>.<bundle ID>, as in DONOR_PUSH_APNS_TEAM_ID and DONOR_PUSH_APNS_TOPIC.
DONOR_IOS_APP_ID=
# Android: the package name and the SHA-256 fingerprints of its signing certificates,
# colon-separated hex, comma-separated (Play Console > App integrity).
DONOR_ANDROID_APP_PACKAGE=
DONOR_ANDROID_APP_CERT_SHA256=

# Optional server-side sign-in and event check-in settings. Stub providers require an
# explicit test-deployment opt-in; live provider credentials go to the API only.
DONOR_SMS_PROVIDER=
DONOR_SMS_ACCOUNT_ID=
DONOR_SMS_AUTH_TOKEN=
DONOR_SMS_FROM=
DONOR_OIDC_MODE=
DONOR_OIDC_APPLE_CLIENT_ID=
DONOR_OIDC_GOOGLE_CLIENT_ID=
DONOR_OIDC_STUB_KEY=
DONOR_ALLOW_SIGN_IN_STUBS=false
DONOR_EVENT_CHECKIN_SECRET=
# Keys the hashes of imported website waitlist addresses (D-6). 32-byte URL-safe base64:
# openssl rand -base64 32 | tr '+/' '-_'. Changing it means re-importing the waitlist.
DONOR_FOUNDING_CLAIM_KEY=
DONOR_SUPPORT_EMAIL=
DONOR_SMTP_CA=
