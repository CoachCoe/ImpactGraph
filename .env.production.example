# Production stack configuration for docker-compose.prod.yml.
# Copy to .env.production and fill in. Never commit the filled copy.

# Images
IMAGE_PREFIX=impactgraph          # or ghcr.io/<owner>, <account>.dkr.ecr.<region>.amazonaws.com
IMAGE_TAG=latest

# Database (the compose stack runs its own PostgreSQL; use a managed one for real traffic)
POSTGRES_USER=impactgraph
POSTGRES_PASSWORD=                # required, no default
POSTGRES_DB=impactgraph

# Ports on the host
API_PORT=8000
WEB_PORT=3000

# Chain. DEMO_MODE=sepolia requires CHAIN_ID=11155111.
DEMO_MODE=sepolia
CHAIN_ID=11155111
CHAIN_NAME=Ethereum Sepolia
RPC_URL=
IMPACT_REGISTRY_ADDRESS=
BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
BLOCKCHAIN_CONFIRMATIONS_REQUIRED=2

# Must stay empty on a public network. The backend holds no key and must not sign;
# verifier attestations are signed by the browser wallet.
EVM_SENDER_ADDRESS=

# Baked into the web bundle at build time. Changing these requires a rebuild.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Ethereum Sepolia
NEXT_PUBLIC_IMPACT_REGISTRY_ADDRESS=

# Deterministic by default. Any other value fails at startup until a provider is built.
AI_PROVIDER=mock

# Maximum evidence upload, in bytes.
MAX_UPLOAD_BYTES=1048576
