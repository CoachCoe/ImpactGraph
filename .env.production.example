# Production stack configuration for docker-compose.prod.yml.
# Copy to .env.production and fill in. Never commit the filled copy.

# Images
IMAGE_PREFIX=impactgraph          # or ghcr.io/<owner>, <account>.dkr.ecr.<region>.amazonaws.com
IMAGE_TAG=latest

# Database (the compose stack runs its own PostgreSQL; use a managed one for real traffic)
POSTGRES_USER=impactgraph
POSTGRES_PASSWORD=                # required, no default
POSTGRES_DB=impactgraph

# Ports on the host
API_PORT=8000
WEB_PORT=3000

# Chain. DEMO_MODE=sepolia requires CHAIN_ID=11155111.
DEMO_MODE=sepolia
CHAIN_ID=11155111
CHAIN_NAME=Ethereum Sepolia
RPC_URL=
IMPACT_REGISTRY_ADDRESS=
BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
BLOCKCHAIN_CONFIRMATIONS_REQUIRED=2

# Must stay empty on a public network. The backend holds no key and must not sign;
# verifier attestations are signed by the browser wallet.
EVM_SENDER_ADDRESS=

# Baked into the web bundle at build time. Changing these requires a rebuild.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Ethereum Sepolia
NEXT_PUBLIC_IMPACT_REGISTRY_ADDRESS=

# Offline fixture by default; use tinker for hosted Inkling extraction.
AI_PROVIDER=mock
# Required when AI_PROVIDER=tinker. Keep it in managed secret storage in production.
TINKER_API_KEY=
EXTRACTION_MODEL=thinkingmachines/Inkling-Small

# Required. Generate 32 random bytes and encode them as base64. Losing this makes all
# evidence unreadable; restoring an old copy may undo a prior crypto-erasure. Store and
# back it up separately from evidence-data. See docs/key-rotation.md.
EVIDENCE_ENCRYPTION_KEY=

# Maximum evidence upload, in bytes.
MAX_UPLOAD_BYTES=1048576

# Bearer token a Prometheus scraper presents to read /metrics. Left empty, the endpoint
# answers only callers on this deployment's own network -- which is the right answer when
# the scraper is a sidecar, and the wrong one the moment it is not. Setting it replaces
# that network check rather than adding to it.
METRICS_TOKEN=

# Addresses whose X-Forwarded-For may be believed when rate limiting. Behind a load
# balancer this must name it, or every caller is counted as the balancer and the limit
# protects nothing.
TRUSTED_PROXY_ADDRESSES=
