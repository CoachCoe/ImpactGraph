# Runtime
APP_ENV=development
DEMO_MODE=local
PERSISTENCE_MODE=postgres
DATABASE_URL=postgresql+psycopg://impactgraph:impactgraph@localhost:55432/impactgraph
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_BLOCK_EXPLORER_URL=
# Baked into the web bundle at build time; the proof panel uses them to name the network
# truthfully. "Verified on Ethereum" is shown only for chain 1 or 11155111.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME=Anvil local EVM
NEXT_PUBLIC_IMPACT_REGISTRY_ADDRESS=

# EVM. Local defaults target Anvil; Sepolia must be selected explicitly.
CHAIN_ID=31337
CHAIN_NAME=Anvil Local EVM
RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=
IMPACT_REGISTRY_ADDRESS=
EVM_SENDER_ADDRESS=
OPERATOR_WALLET_ADDRESS=
VERIFIER_WALLET_ADDRESS=
CONTRACT_ARTIFACT_PATH=../../contracts/out/ImpactRegistry.sol/ImpactRegistry.json
BLOCK_EXPLORER_URL=
BLOCKCHAIN_CONFIRMATIONS_REQUIRED=1

# Local-only filesystem evidence storage
EVIDENCE_STORAGE_PATH=./var/evidence
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,text/plain

# Deterministic by default; no paid API required
# mock reads only the seeded INV-8291 fixture and needs no network, which is what CI
# runs on. tinker reads real documents and requires TINKER_API_KEY; the API refuses to
# start without it rather than failing in front of an operator mid-upload.
# Wraps every evidence object's own data key. Destroying a wrapped key is how evidence is
# erased while the commitment to it stays true (ADR-011). Generate your own:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Objects and their wrapped keys live apart, so a backup of one does not undo an erasure.
EVIDENCE_KEY_PATH=./var/evidence-keys
EVIDENCE_ENCRYPTION_KEY=

# Addresses whose X-Forwarded-For may be believed when rate limiting the public API.
# Left empty, the header is ignored and the connecting address is used, because the header
# is set by whoever is calling.
TRUSTED_PROXY_ADDRESSES=

AI_PROVIDER=mock
EXTRACTION_MODEL=thinkingmachines/Inkling-Small
# Never commit a real key. .env is gitignored; this file is not.
TINKER_API_KEY=
AI_API_KEY=

# Never commit funded wallet keys. Anvil defaults are development-only.
DEPLOYER_PRIVATE_KEY=
